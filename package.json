{
  "name": "@profullstack/autopost",
  "version": "0.1.0",
  "description": "Typed Node SDK for posting to social platforms via a Crawlproof account. List a user's connected social accounts and publish to them from any Node program, CI job, or CLI.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "autopost",
    "crawlproof",
    "social",
    "social-posting",
    "bluesky",
    "reddit",
    "mastodon",
    "linkedin",
    "twitter",
    "x",
    "facebook",
    "threads",
    "discord",
    "telegram",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/profullstack/autopost.git"
  },
  "homepage": "https://github.com/profullstack/autopost#readme",
  "bugs": "https://github.com/profullstack/autopost/issues",
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.5.1",
    "typescript": "^5.6.3",
    "vitest": "^4.1.6"
  }
}
